{
  "manifest_version": 3,
  "name": "WebSpaces",
  "version": "0.1.0",
  "description": "Firefox-style containers built on Chrome tab groups: a cookie vault per container and session backup to JSON.",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "WebSpaces"
  },
  "options_page": "ui/options.html",
  "permissions": [
    "tabs",
    "tabGroups",
    "cookies",
    "storage",
    "unlimitedStorage",
    "declarativeNetRequest",
    "browsingData",
    "webNavigation",
    "contextMenus",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ui/frozen.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
